# Copy to backend/.env (never commit .env).

# Luna — AI explanations (Groq). Without a key Luna answers from built-in templates.
GROQ_API_KEY=
LUNA_MODEL=qwen/qwen3.8-27b
# Optional tuning:
# LUNA_TEMPERATURE=0.4
# LUNA_MAX_TOKENS=2048
# LUNA_REASONING_EFFORT=medium   # empty = not sent; lower = faster first word
# LUNA_REASONING_FORMAT=hidden   # hide the model's thinking from the answer
# LUNA_TIMEOUT_S=45

# Allowed frontend origins (comma separated).
# FRONTEND_ORIGINS=http://localhost:5173
